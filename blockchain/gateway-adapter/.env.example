# .env.example — Gateway Adapter configuration.
#
# Copy to .env and adjust paths if your Phase 5A network layout
# differs. Values below match Phase 5A's actual network exactly (see
# PROJECT_STATE.md's Phase 5A section and blockchain/network/scripts/).
#
# This adapter loads these via process.env — nothing here is
# hardcoded into source, and this .env.example file itself contains
# no real secrets (paths only; the files the paths point to are
# git-ignored, generated locally by generate-crypto.sh).

# --- Internal HTTP server ---
ADAPTER_PORT=8081

# --- Fabric network identity (Phase 5A topology) ---
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=paperchannel
FABRIC_CHAINCODE_NAME=paper-ledger

# Peer endpoint exactly as Phase 5A's scripts connect to it. The
# hostname MUST match what cryptogen issued the peer's TLS certificate
# for (peer0.org1.example.com) — connecting via a bare IP fails TLS
# verification. Requires the same /etc/hosts entry Phase 5A's
# network/README.md documents:
#   127.0.0.1 orderer.example.com peer0.org1.example.com
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
# Only needed if FABRIC_PEER_ENDPOINT's hostname does NOT match the
# certificate (e.g. connecting through a different alias/port-forward).
# Unset by default since the above already matches.
# FABRIC_PEER_HOST_ALIAS=

# --- Identity and TLS material (paths, not secrets themselves — the
# files these point to ARE secrets and are git-ignored) ---
# Peer's TLS root CA, used to verify the peer's server certificate:
FABRIC_TLS_CERT_PATH=../network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
# This adapter's own identity (reuses Phase 5A's Org1 Admin identity —
# see fabricGateway.ts's module docstring for why, and the noted
# follow-up to use a narrower identity in a later hardening pass):
FABRIC_CERT_PATH=../network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem
FABRIC_PRIVATE_KEY_PATH=../network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk
