# Copy this file to .env.local (or .env) and adjust for your machine.
# NEVER commit the real .env / .env.local file.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle
# by Vite. Do NOT put backend secrets, database credentials, JWT
# signing keys, Fabric certificates, or any other secret here — this
# file's values are visible to anyone who opens the built frontend in
# a browser.

# Base URL of the FastAPI backend's versioned API, matching
# backend/app/config.py API_V1_PREFIX (default "/api/v1").
VITE_API_BASE_URL=http://localhost:8000/api/v1
