# Copy this file to .env and fill in real values for your machine.
# NEVER commit the real .env file. NEVER put production secrets here.

# --- General ---
# development | staging | production. Anything other than exactly "development" is
# treated as non-development (e.g. OTPs are never logged; see the OTP section below).
APP_ENV=development
DEBUG=true

# --- CORS: comma-separated list of allowed frontend origins ---
# Explicit origins only; "*" is rejected at startup. The Vite dev server in frontend/
# listens on http://localhost:3000. Methods (GET/POST/PATCH), headers (Accept,
# Authorization, Content-Type) and "no credentials" are fixed in code (app/main.py)
# to match the actual API and frontend client; only the origin list is configurable.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://qpaper_user:CHANGE_ME@localhost:5432/qpaper_db
DB_ECHO=false

# --- JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
# NOT YET DETERMINED per LLD 14.6 — working development default; revisit before real use.
JWT_EXPIRE_MINUTES=30

# --- Password hashing ---
PASSWORD_HASH_SCHEME=bcrypt

# --- OTP ---
# --- Second factor (Phase 7A) ---
# totp (DEFAULT, the real method)  : codes come from the user's authenticator app (RFC 6238).
# dev_console (development only)   : legacy console OTP; the plaintext OTP is written to the
#                                    SERVER LOG. Works only with APP_ENV=development AND
#                                    OTP_DEV_LOG_ENABLED=true, otherwise login returns HTTP 503.
# There is still NO email/SMS OTP delivery.
AUTH_SECOND_FACTOR=totp
# Required for totp. A DEDICATED key (not QUESTION_PAPER_MASTER_KEY) that encrypts TOTP secrets
# at rest with AES-256-GCM: base64 of 32 random bytes. Generate:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If it is missing/invalid, TOTP login and enrollment return HTTP 503 and nothing is generated.
# Back it up separately from the database: losing it makes every stored secret unrecoverable
# (everyone must re-enroll); changing it does the same. There is no automatic key rotation.
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=QPaper System
# Accepted clock skew, in 30-second steps each side of "now" (0-2). 1 = +/-30 s.
TOTP_VALID_WINDOW=1
# One-time enrollment code lifetime and wrong-attempt limit before it is destroyed.
TOTP_ENROLLMENT_CODE_TTL_HOURS=24
TOTP_ENROLLMENT_MAX_ATTEMPTS=5

# --- Legacy development OTP (only with AUTH_SECOND_FACTOR=dev_console) ---
OTP_DELIVERY_CHANNEL=NOT_YET_DETERMINED
# Set to true ONLY for a local demo with AUTH_SECOND_FACTOR=dev_console and APP_ENV=development.
OTP_DEV_LOG_ENABLED=false
OTP_EXPIRE_SECONDS=300
# Phase 6E-1: maximum FAILED OTP verification attempts allowed per
# challenge before it is locked (a fresh login is then required).
OTP_MAX_ATTEMPTS=5
# Phase 6E-2: rate limiting for POST /auth/login and POST /auth/otp/verify
# ONLY (never the whole API). In-process, single-instance limiter — see
# app/security/rate_limiter.py for the documented multi-process limitation.
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
# Deliberately higher than OTP_MAX_ATTEMPTS (5): this bounds raw request
# VOLUME (a coarser flood guard), independent of OTP_MAX_ATTEMPTS, which
# bounds WRONG GUESSES against one challenge. See app/config.py for the
# full reasoning.
AUTH_OTP_RATE_LIMIT=15
AUTH_OTP_RATE_WINDOW_SECONDS=60

# --- Storage ---
# Provider is NOT YET DETERMINED (LLD DD-13). "local" is dev-only.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage_data

# --- Phase 3: paper encryption ---
# Base64-encoded 32-byte (256-bit) master key. Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
QUESTION_PAPER_MASTER_KEY=CHANGE_ME_GENERATE_A_32_BYTE_BASE64_KEY
PAPER_MAX_UPLOAD_SIZE_BYTES=20971520

# --- Blockchain (Hyperledger Fabric) ---
# "stub" is the Phase-1 in-memory placeholder (default; keep this for
# local dev/tests). "fabric" is the Phase 5C real integration — set
# FABRIC_GATEWAY_ENDPOINT to the running Fabric Gateway Adapter's base
# URL (blockchain/gateway-adapter/) and start that adapter first.
BLOCKCHAIN_BACKEND=stub
FABRIC_GATEWAY_ENDPOINT=
FABRIC_GATEWAY_TIMEOUT_SECONDS=5.0
# Not currently read by the backend — see app/config.py comment.
FABRIC_CHANNEL_NAME=
FABRIC_CHAINCODE_NAME=

# Phase 5E: what to do at paper-retrieval time when blockchain-backed
# integrity verification (verify_paper_hash) cannot be completed (Fabric
# unreachable/timeout, or this paper has no ledger record at all). Has NO
# effect under BLOCKCHAIN_BACKEND=stub (verify_paper_hash is never called
# there at all — see app/services/paper_service.py). An explicit ledger
# match=False ALWAYS rejects the paper (HTTP 409) regardless of this
# setting; this setting only governs the "couldn't get an answer" case.
#   best_effort (default) — proceed on local AES-256-GCM + SHA-256 checks
#                            alone; record BLOCKCHAIN_VERIFICATION_UNAVAILABLE.
#   strict                — reject retrieval with HTTP 503 instead.
FABRIC_VERIFICATION_MODE=best_effort

# --- Logging ---
LOG_LEVEL=INFO
