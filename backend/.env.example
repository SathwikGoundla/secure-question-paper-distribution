# Copy this file to .env and fill in real values for your machine.
# NEVER commit the real .env file. NEVER put production secrets here.

# --- General ---
APP_ENV=development
DEBUG=true

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://qpaper_user:CHANGE_ME@localhost:5432/qpaper_db
DB_ECHO=false

# --- JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
# NOT YET DETERMINED per LLD 14.6 — working development default; revisit before real use.
JWT_EXPIRE_MINUTES=30

# --- Password hashing ---
PASSWORD_HASH_SCHEME=bcrypt

# --- OTP ---
# Delivery channel is NOT YET DETERMINED (SRS OQ-4, LLD DD-12).
# Leaving this as-is uses the Phase-1 DevConsoleOTPProvider (logs the OTP; dev-only).
OTP_DELIVERY_CHANNEL=NOT_YET_DETERMINED
OTP_EXPIRE_SECONDS=300

# --- Storage ---
# Provider is NOT YET DETERMINED (LLD DD-13). "local" is dev-only.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage_data

# --- Blockchain (Hyperledger Fabric) ---
# "stub" is the Phase-1 placeholder (see app/services/blockchain_service.py).
# Real Fabric integration is added in the Blockchain Development phase.
BLOCKCHAIN_BACKEND=stub
FABRIC_GATEWAY_ENDPOINT=
FABRIC_CHANNEL_NAME=
FABRIC_CHAINCODE_NAME=

# --- Logging ---
LOG_LEVEL=INFO
